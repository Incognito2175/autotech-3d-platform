# =============================================================================
# Variables de entorno — Autotech 3D Backend
# =============================================================================
# Copie este archivo como .env y configure los valores reales.
# NUNCA suba el archivo .env al control de versiones.

# Entorno: development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi.py

# Clave secreta para tokens (cámbiela en producción)
SECRET_KEY=cambie-esta-clave-por-una-segura

# ─── Base de datos MySQL ──────────────────────────────────────────────────────
# Formato: mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Si root no tiene contraseña: mysql+pymysql://root:@localhost:3306/autotech_db
DATABASE_URL=mysql+pymysql://root:TU_CONTRASEÑA@localhost:3306/autotech_db

# ─── Orígenes CORS (frontend React) ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

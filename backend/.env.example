# =============================================================================
# Variables de entorno — Autotech 3D Backend
# =============================================================================
# Copie este archivo como .env y configure los valores reales.
# NUNCA suba el archivo .env al control de versiones.

# Entorno: development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi.py

# Clave secreta para tokens (cámbiela en producción)
SECRET_KEY=cambie-esta-clave-por-una-segura

# Base de datos (SQLite por defecto para desarrollo)
# SQLite:
DATABASE_URL=sqlite:///autotech.db
# MySQL:
# DATABASE_URL=mysql+pymysql://usuario:contraseña@host:3306/autotech_db

# Orígenes permitidos para CORS (el frontend React, separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
